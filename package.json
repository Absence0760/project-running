{
  "name": "run-app-root",
  "private": true,
  "workspaces": [
    "apps/web",
    "apps/backend"
  ],
  "scripts": {
    "dev:db:up": "cd apps/backend && supabase start",
    "dev:db:down": "cd apps/backend && supabase stop",
    "dev:db:reset": "cd apps/backend && supabase db reset",
    "dev:db:status": "cd apps/backend && supabase status",
    "dev:db:studio": "xdg-open http://127.0.0.1:54323",
    "dev:db:mailpit": "xdg-open http://127.0.0.1:54324",
    "dev:db:psql": "psql postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    "dev:db:logs": "docker logs -f supabase_db_backend",
    "dev:db:seed-tracks": "node scripts/seed-run-tracks.mjs",
    "dev:run:web": "pnpm -C apps/web dev",
    "dev:run:web:preview": "pnpm -C apps/web preview",
    "dev:run:fns": "cd apps/backend && supabase functions serve --env-file .env.local",
    "dev:run:android": "cd apps/mobile_android && flutter run",
    "dev:run:ios": "cd apps/mobile_ios && flutter run",
    "dev:run:worker": "cd apps/job_worker && go run .",
    "dev:setup:osrm": "cd apps/job_worker/osrm && make download && make build",
    "dev:run:osrm": "node scripts/dev_run_osrm.mjs",
    "dev:tiles:up": "bin/protomaps-dev.sh start",
    "dev:tiles:down": "bin/protomaps-dev.sh stop",
    "dev:tiles:restart": "bin/protomaps-dev.sh restart",
    "dev:tiles:status": "bin/protomaps-dev.sh status",
    "dev:tiles:logs": "bin/protomaps-dev.sh logs",
    "dev:tiles:fetch": "bin/protomaps-dev.sh fetch",
    "dev:tiles:env": "bin/protomaps-dev.sh env",
    "emu:android:list": "flutter emulators",
    "emu:android:launch": "flutter emulators --launch",
    "build:web": "pnpm -C apps/web build",
    "build:android": "cd apps/mobile_android && flutter build apk",
    "install:android": "cd apps/mobile_android && adb install build/app/outputs/flutter-apk/app-release.apk",
    "install:android:debug": "cd apps/mobile_android && adb install build/app/outputs/flutter-apk/app-debug.apk",
    "build:ios": "cd apps/mobile_ios && flutter build ios --no-codesign",
    "build:worker": "cd apps/job_worker && go build .",
    "check:web": "pnpm -C apps/web check",
    "check:flutter": "melos exec -- dart analyze",
    "gen:types": "pnpm -C apps/backend gen:types",
    "gen:types:check": "pnpm -C apps/backend gen:types:check",
    "gen:dart": "dart run scripts/gen_dart_models.dart",
    "gen:all": "pnpm gen:types && pnpm gen:dart",
    "test:web:unit": "pnpm -C apps/web test:unit",
    "test:web:e2e": "pnpm -C apps/web test:e2e",
    "test:web:e2e:ui": "pnpm -C apps/web test:e2e:ui",
    "test:flutter": "melos exec -- flutter test",
    "test:worker": "cd apps/job_worker && go test ./...",
    "setup:install": "pnpm install",
    "setup:flutter": "dart pub get && melos bootstrap",
    "test:scripts": "node scripts/check_root_scripts.mjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.13"
  },
  "overrides": {
    "cookie": "^1.0.2",
    "devalue": "^5.8.1",
    "@sveltejs/kit": {
      "cookie": "^1.0.2",
      "devalue": "^5.8.1"
    }
  },
  "pnpm": {
    "overrides": {
      "cookie": "^1.0.2",
      "devalue": "^5.8.1",
      "@sveltejs/kit>cookie": "^1.0.2",
      "@sveltejs/kit>devalue": "^5.8.1"
    }
  },
  "_overrides_rationale": "/audit/all High (deps): @sveltejs/kit@2.59.x pulls cookie@^0.6.0, which has GHSA-pxg6-pf52-xh8x (out-of-bounds chars in name/path/domain). Upstream hasn't bumped yet. Top-level override deduplicates direct copies but npm leaves SvelteKit's nested node_modules/@sveltejs/kit/node_modules/cookie@0.6.0 in place because the v0.x → v1.x range jump is outside SvelteKit's declared dependency range. The nested @sveltejs/kit > cookie override forces that transitive copy too. The API surface SvelteKit uses is the v0.x compatible subset, so the bump is safe in practice. Drop both entries once @sveltejs/kit ships its own bump. devalue override: @sveltejs/kit@2.59.1 declares devalue ^5.6.4 which still resolves to 5.8.0 (GHSA-77vg-94rm-hx3p — sparse-array DoS). Patch fix is in 5.8.1, inside Kit's declared range, so the override just nudges resolution to the patched version. Drop once Kit's lockfile picks it up upstream."
}
