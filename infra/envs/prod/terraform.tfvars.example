# Copy to terraform.tfvars (gitignored) before applying.
#
# These are non-secret config values. Real secrets (ANTHROPIC_API_KEY,
# server-side SENTRY_DSN) live in the sops-encrypted file in the PRIVATE
# estate repo — ../infra-secrets/running/prod.sops.yaml — not here and
# NOT anywhere in this public repo.

apex_domain              = "threkir.com"
public_supabase_url      = "https://api.threkir.com"
public_supabase_anon_key = "ey..." # publishable key, NOT service-role

extra_lambda_env = {
  # COACH_PROVIDER = "anthropic"   # default
  # APP_RELEASE    = "web@1.0.0"   # set by CI on tag deploys
}

# AWS Budgets — account-wide spend ceiling. See infra/envs/prod/budgets.tf.
# At least one email address is required. 30 suits the rock-bottom tier
# (~$10/mo AWS baseline); raise toward ~150 for the full launch profile.
monthly_budget_limit_usd = 30
budget_alert_emails      = ["you@example.com"]

# SNS subscribers for the per-env alerts topic the coach Lambda
# alarms (errors, p95 duration, throttles) route to. At least one
# address is required for prod — see infra/modules/web-stack/alarms.tf
# and the /audit/all cost-controls Medium (2026-05-07). The validation
# rejects @example.com placeholders, so replace this before applying.
alert_emails = ["you@example.com"]
