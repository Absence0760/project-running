# ─────────────────────────────────────────────────────────────────────────
# Local development defaults — committed on purpose.
#
# Vite loads this file ONLY for `vite dev` (the dev server). The production
# `vite build` reads `.env.production` / CI env instead, so nothing here can
# leak into a prod bundle. Everything below is local-stack and non-secret:
# the anon + service-role keys are the STANDARD PUBLIC Supabase local demo
# keys (identical on every machine) and every URL is loopback.
#
# Need a real external key (MapTiler, Anthropic, Strava, RevenueCat)? Put it
# in a gitignored `apps/web/.env.local` — Vite loads that with higher
# priority and it overrides anything here. Don't edit this file for
# machine-specific values, and don't add real secrets to it.
# ─────────────────────────────────────────────────────────────────────────

PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Service-role key (SERVER-ONLY; never PUBLIC_). The coach handler uses it to
# persist the assistant message. Standard public local demo key — safe here.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Map tiles → local Protomaps tileserver (`npm run dev:tiles:up`). Committed
# ON here because `.env.development` is the HIGHEST-priority env file Vite
# loads for `vite dev` — it wins over `.env.local` (decisions.md § 137), so
# this is the only file where the override actually takes effect. Boot the
# tileserver before `npm run dev`, or the map falls back to MapTiler / the OSM
# raster style. CI e2e forces this back to empty via the Playwright
# `webServer.env` (tests-e2e/playwright*.config.ts) so the suite never chases a
# tileserver the runner doesn't boot. Per-machine override: your shell env or
# apps/web/.env.development.local (both outrank this file) — a plain `.env.local`
# will NOT win.
PUBLIC_TILE_STYLE_URL=http://localhost:8080/styles/basic/style.json

# Server-side distance-targeted route generation → local GraphHopper
# (`npm run dev:run:graphhopper`). SERVER-ONLY (no PUBLIC_ prefix — the browser
# never reaches the engine). OFF by default so a fresh `vite dev` (and CI e2e)
# gets a 501 from /api/routes/generate and the route builder falls back to the
# in-browser OSRM heuristic — generation still works, just the legacy path.
# Running the local engine? Set GRAPHHOPPER_URL here in .env.development (or
# your shell / .env.development.local) — NOT .env.local, which Vite ranks below
# this file (decisions § 137), so a value there is silently ignored:
#   GRAPHHOPPER_URL=http://127.0.0.1:8989
GRAPHHOPPER_URL=

# Shared secret sent to GraphHopper as X-Engine-Key (the Caddy guard in front of
# the engine checks it). Committed NON-SECRET dev value matching the one the
# local container defaults to (docker-compose.yml), so the opt-in local engine
# works out of the box. Prod injects a real secret via sops → the Lambda env.
GRAPHHOPPER_API_KEY=dev-graphhopper-key

# Server-side graph-cycle loop generation → local graph_cycle sidecar
# (`apps/graph_cycle`; `make dev` or `make serve`). SERVER-ONLY (no PUBLIC_).
# Tried FIRST by /api/routes/generate, ahead of GraphHopper. OFF by default so a
# fresh `vite dev` (and CI e2e) skips it and round_trip / the in-browser OSRM
# heuristic serves. Running the local sidecar? Set it here in .env.development
# (or your shell / .env.development.local) — NOT .env.local, which Vite ranks
# below this file (decisions § 137). Host port 8991, not 8989, so it coexists
# with the local GraphHopper:
#   GRAPH_CYCLE_URL=http://127.0.0.1:8991
GRAPH_CYCLE_URL=

# Shared secret sent to the sidecar as X-Engine-Key (the in-process guard checks
# it). Committed NON-SECRET dev value matching the sidecar's docker-compose
# default, so the opt-in local sidecar works out of the box. Prod injects a real
# secret via sops → the Lambda env.
GRAPH_CYCLE_API_KEY=dev-graph-cycle-key

# Waypoint routing for the route builder (/routes/new) → local OSRM
# (`npm run dev:run:osrm`). Committed ON so the builder uses the local engine
# instead of the public demo router.project-osrm.org, which is rate-limited and
# 502s under load. Empty/unset → falls back to that public demo. Build a region
# first: `dev:setup:osrm` defaults to Victoria AU — override REGION_URL with your
# area's Geofabrik PBF, or the local engine returns degenerate (zero-length)
# routes. CI e2e forces this empty via the Playwright `webServer.env` (no local
# OSRM on the runner). Outranks .env.local (§ 137); per-machine override → shell
# or .env.development.local.
PUBLIC_OSRM_URL=http://localhost:5000

# AI Coach → local Ollama (no API key, no cost). `npm run dev:core` pulls the
# model for you; or run `ollama pull llama3.2` yourself. Swap OPENAI_MODEL
# for any model you've pulled (`ollama list`).
COACH_PROVIDER=openai
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.2

# Open the Pro-gated coach UI for the free seed user during local dev.
# CLIENT-side gate only (read by src/lib/settings/features.ts) — it just
# unlocks the surface so you don't have to be Pro to open /coach locally.
# The SERVER-side bypass `BYPASS_PAYWALL` is intentionally NOT set here:
# `.env.development` is loaded by `vite dev` (which the Playwright e2e
# suite runs), and Vite ranks `.env.development` above `.env.local`, so a
# `BYPASS_PAYWALL=true` here would override `.env.local`/CI and silently
# disable the daily-cap gate the paywall-wire + tier-cache e2e tests
# verify (handler.ts skips the whole cap branch when it's on). Set
# `BYPASS_PAYWALL=true` in your gitignored `.env.local` if you want the
# cap off for ad-hoc local prompting. Dev-only either way: the prod coach
# Lambda hardcodes the bypass off, and this file is never read by
# `vite build`.
PUBLIC_BYPASS_PAYWALL=true

# AI Coach is live in local dev (Ollama above), so mark it enabled: this keeps
# the /settings/upgrade Pro card purchasable and the Coach surface visible, which
# the paywall + coach e2e suites assert. Fail-closed at rock-bottom (unset → the
# storefront shows a "coming soon" teaser and leads with donations). paywall.md.
PUBLIC_COACH_ENABLED=true

# Server route generation is a Pro perk (decisions §204). Enabled in dev so the
# /settings/upgrade route-gen bullet renders and the /routes/new 403 upsell path
# is e2e-testable (builder.spec mocks the 403 — the dev server itself has no
# engines, so real requests 501 before the tier gate and never upsell).
# Fail-closed at rock-bottom AND Lean (engines deferred → leave unset).
PUBLIC_ROUTE_GEN_ENABLED=true

# Google sign-in button. On in local dev + e2e (vite dev loads this file) so the
# /login Continue-with-Google button stays wired and the smoke / i18n / age-gate
# specs that click or read it keep passing. Fail-closed (src/lib/core/google_auth_flag.ts):
# unset in prod until the Supabase `google` provider is configured, so the button
# shows a "coming soon" pill instead of an opaque provider error. See web_app_auth.md.
PUBLIC_GOOGLE_AUTH_ENABLED=true

# Charity fundraising / donations UI. On in local dev + e2e so the fundraiser
# create CTA + public /fundraisers/[id] page render and the fundraising e2e spec
# passes. Fail-closed (src/lib/social/fundraising_flag.ts): unset in prod until
# Stripe Connect + the owner/CISO/counsel sign-off land, so every donate surface
# hides rather than dead-ending on the 503 Edge Function. fundraising.md, §222.
PUBLIC_FUNDRAISING_ENABLED=true
