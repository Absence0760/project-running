PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_MAPTILER_KEY=
# Optional dev override that points the map renderer at a different
# MapLibre style URL (typically a local Protomaps tileserver-gl).
# When set, the override wins outright — MapTiler is bypassed and
# the user's chosen style preference is ignored. Empty → falls back
# to MapTiler. Boot the local server with `bin/protomaps-dev.sh
# start` and copy the printed URL here. See
# docs/protomaps_local_setup.md + decisions.md § 68.
PUBLIC_TILE_STYLE_URL=
# OSRM routing-service base URL. Empty → falls back to the public
# https://router.project-osrm.org demo server (rate-limited, sometimes
# overloaded). Set to a self-hosted instance for production-quality
# turn-by-turn snapping; the apps/job_worker/osrm/ recipe and the
# `npm run dev:run:osrm` helper script provision one locally.
PUBLIC_OSRM_URL=
# Strava OAuth — public client ID is embedded in the redirect URL; the
# non-PUBLIC client id + secret live ONLY in apps/backend/.env.example
# (the Edge Function reads them at runtime). They were here once and
# the audit-secrets pass flagged them as misleading — the web bundle
# doesn't read either, so setting them in apps/web/.env.local is a
# no-op that creates false confidence.
PUBLIC_STRAVA_CLIENT_ID=
# RevenueCat web SDK public key (optional). When unset, the "Get Pro"
# CTA on /settings/upgrade falls back to a "coming soon" toast instead
# of opening a real checkout.
PUBLIC_REVENUECAT_WEB_API_KEY=
# Go live-hub base URL — e.g. https://live.threkir.com. When set,
# `/live/[id]` opens a WebSocket to
# `${PUBLIC_LIVE_HUB_URL}/v1/live/{run_id}/subscribe` for real-time
# spectator pings instead of the Supabase Realtime channel on
# `live_run_pings`. Empty → falls back to the legacy Realtime path.
# See `apps/web/src/lib/live_hub.ts` + `apps/job_worker/internal/livehub/`.
PUBLIC_LIVE_HUB_URL=
# Go service base URL for the cloud-export endpoint. Same host as
# PUBLIC_LIVE_HUB_URL in production (the Go service hosts both
# /v1/live and /v1/export). When set, the Settings → Data Export
# "Cloud export (GPX zip)" button POSTs to `${PUBLIC_EXPORT_HUB_URL}/v1/export`
# instead of the legacy `export-data` Edge Function. Empty → falls
# back to the EF. See `apps/web/src/lib/cloud_export.ts`.
PUBLIC_EXPORT_HUB_URL=
# Canonical site URL used by the prerendered /sitemap.xml. The build
# bakes this into every <loc>, so preview and prod each emit their
# own host. Unset → defaults to https://threkir.com (matches prod).
PUBLIC_SITE_URL=
ANTHROPIC_API_KEY=
# Coach provider switch. `anthropic` (default, prod) or `openai` for any
# OpenAI-compatible /v1 endpoint (Ollama, llama.cpp, vLLM, LM Studio).
# When set to `openai`, ANTHROPIC_API_KEY is ignored.
COACH_PROVIDER=anthropic
# Only used when COACH_PROVIDER=openai. Defaults below match a local
# Ollama install (`ollama serve` on :11434, model pulled via `ollama pull`).
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=ollama
OPENAI_MODEL=llama3.2
# Web push (optional). Generate a VAPID keypair (e.g. `npx web-push
# generate-vapid-keys`); the PUBLIC half lives in the browser bundle to
# subscribe with, the PRIVATE half lives in the Edge Function env to
# sign push payloads. Without these the "Notifications" card on
# /settings/account renders a "not configured" hint instead of the
# Enable button.
PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Sentry (optional). The PUBLIC_ DSN is the browser SDK's; the
# server-side SENTRY_DSN is injected at runtime by the Lambda env
# (sops-encrypted) — not needed in apps/web/.env.local for local dev.
# PUBLIC_APP_RELEASE is set by the release-web.yml CI step to the
# git tag (`web@1.2.3`) so Sentry can correlate errors to a specific
# build; leave blank locally.
PUBLIC_SENTRY_DSN=
PUBLIC_APP_RELEASE=
# BYPASS_PAYWALL has been intentionally removed from .env.example.
# The `/api/coach` dev wrapper still accepts it locally, but only when
# all of the following are simultaneously true:
#   - NODE_ENV is not 'production'
#   - PUBLIC_SUPABASE_URL points at the local stack (127.0.0.1 / localhost)
#   - the literal string 'true'
# Production code path is the AWS Lambda, which hardcodes the bypass
# off. There is no scenario in which it should appear in a checked-in
# example file — set it ad-hoc in your own .env.local if you need it.
#
# Client-side companion `PUBLIC_BYPASS_PAYWALL` opens the UI-gate
# (`isLocked()` in `$lib/features.ts`) for free users on a dev machine
# so the `<ProGate>` lock-card doesn't block local iteration on /coach.
# Same three-condition AND on the client (`import.meta.env.DEV` +
# local Supabase URL + literal 'true'). Keep both flags out of this
# template — set per-machine in `.env.local`.
