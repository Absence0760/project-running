{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "run-app-web",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev --port 7777",
		"build": "vite build",
		"preview": "vite preview --port 8888",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:check-constraints": "node scripts/check_constraint_unions.mjs",
		"test:unit": "tsx --test 'src/lib/**/*.test.ts'",
		"test:e2e": "playwright test --config=tests-e2e/playwright.config.ts",
		"test:e2e:ui": "playwright test --config=tests-e2e/playwright.config.ts --ui",
		"test:e2e:livehub": "playwright test --config=tests-e2e/playwright.livehub.config.ts"
	},
	"devDependencies": {
		"@iconify-json/material-symbols": "1.2.76",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/adapter-vercel": "6.3.3",
		"@sveltejs/kit": "2.63.1",
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"@types/aws-lambda": "8.10.162",
		"@types/node": "^25.9.2",
		"esbuild": "0.28.0",
		"mdsvex": "^0.12.7",
		"normalize.css": "8.0.1",
		"svelte": "5.56.3",
		"svelte-check": "4.6.0",
		"typescript": "6.0.3",
		"unplugin-icons": "23.0.1",
		"vite": "8.0.16"
	},
	"type": "module",
	"dependencies": {
		"@anthropic-ai/sdk": "^0.102.0",
		"@resvg/resvg-js": "^2.6.2",
		"@revenuecat/purchases-js": "^1.42.1",
		"@sentry/sveltekit": "^10.56.0",
		"@supabase/ssr": "^0.10.3",
		"@supabase/supabase-js": "^2.107.0",
		"@zip.js/zip.js": "^2.7.45",
		"fit-file-parser": "^3.0.2",
		"html-to-image": "^1.11.13",
		"isomorphic-dompurify": "^3.16.0",
		"jszip": "^3.10.1",
		"maplibre-gl": "^5.24.0",
		"marked": "^18.0.5",
		"material-symbols": "^0.44.12"
	}
}
