{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "run-app-web",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev --port 7777",
		"build": "vite build",
		"preview": "vite preview --port 8888",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:check-constraints": "node scripts/check_constraint_unions.mjs",
		"check:e2e-types": "svelte-kit sync && tsc --noEmit -p tsconfig.tests-e2e.json",
		"check:node-types": "svelte-kit sync && tsc --noEmit -p tsconfig.node.json",
		"check:sw-types": "svelte-kit sync && tsc --noEmit -p tsconfig.service-worker.json",
		"test:tsconfig-coverage": "svelte-kit sync && node --test scripts/tsconfig_coverage.test.mjs",
		"test:unit": "tsx --test 'src/**/*.test.ts' 'tests-e2e/fixtures/**/*.test.ts'",
		"test:e2e": "svelte-kit sync && playwright test --config=tests-e2e/playwright.config.ts",
		"test:e2e:ui": "svelte-kit sync && playwright test --config=tests-e2e/playwright.config.ts --ui",
		"test:e2e:livehub": "svelte-kit sync && playwright test --config=tests-e2e/playwright.livehub.config.ts",
		"test:e2e:exporthub": "svelte-kit sync && playwright test --config=tests-e2e/playwright.exporthub.config.ts",
		"test:e2e:sso": "svelte-kit sync && playwright test --config=tests-e2e/playwright.sso.config.ts"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@types/aws-lambda": "8.10.162",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.4.0",
		"esbuild": "0.28.2",
		"mdsvex": "^0.12.8",
		"oauth2-mock-server": "9.1.0",
		"svelte": "5.56.10",
		"svelte-check": "4.7.6",
		"tsx": "^4.23.12",
		"typescript": "6.0.3",
		"vite": "8.2.2"
	},
	"type": "module",
	"dependencies": {
		"@anthropic-ai/sdk": "^0.122.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sentry/sveltekit": "^10.71.0",
		"@supabase/ssr": "^0.12.5",
		"@supabase/supabase-js": "^2.112.3",
		"@zip.js/zip.js": "^2.8.60",
		"fit-file-parser": "^4.1.0",
		"html-to-image": "^1.11.13",
		"isomorphic-dompurify": "^3.23.0",
		"jszip": "^3.10.1",
		"maplibre-gl": "^6.6.0",
		"marked": "^18.0.11",
		"material-symbols": "^0.47.0"
	}
}
