{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "run-app-web",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev --port 7777",
		"build": "vite build",
		"preview": "vite preview --port 8888",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:check-constraints": "node scripts/check_constraint_unions.mjs",
		"test:unit": "tsx --test 'src/**/*.test.ts'",
		"test:e2e": "svelte-kit sync && playwright test --config=tests-e2e/playwright.config.ts",
		"test:e2e:ui": "svelte-kit sync && playwright test --config=tests-e2e/playwright.config.ts --ui",
		"test:e2e:livehub": "svelte-kit sync && playwright test --config=tests-e2e/playwright.livehub.config.ts",
		"test:e2e:sso": "svelte-kit sync && playwright test --config=tests-e2e/playwright.sso.config.ts"
	},
	"devDependencies": {
		"@iconify-json/material-symbols": "1.2.88",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.2",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@types/aws-lambda": "8.10.162",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^26.1.2",
		"esbuild": "0.28.1",
		"mdsvex": "^0.12.8",
		"normalize.css": "8.0.1",
		"oauth2-mock-server": "9.1.0",
		"svelte": "5.56.8",
		"svelte-check": "4.7.4",
		"typescript": "6.0.3",
		"unplugin-icons": "23.0.1",
		"vite": "8.2.1"
	},
	"type": "module",
	"dependencies": {
		"@anthropic-ai/sdk": "^0.115.0",
		"@resvg/resvg-js": "^2.6.2",
		"@sentry/sveltekit": "^10.69.0",
		"@supabase/ssr": "^0.12.4",
		"@supabase/supabase-js": "^2.110.8",
		"@zip.js/zip.js": "^2.8.34",
		"fit-file-parser": "^4.1.0",
		"html-to-image": "^1.11.13",
		"isomorphic-dompurify": "^3.21.0",
		"jszip": "^3.10.1",
		"maplibre-gl": "^6.1.0",
		"marked": "^18.0.7",
		"material-symbols": "^0.45.10"
	}
}
