{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "run-app-web",
	"version": "0.0.1",
	"private": true,
	"scripts": {
		"dev": "vite dev --port 7777",
		"build": "vite build",
		"preview": "vite preview --port 8888",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:check-constraints": "node scripts/check_constraint_unions.mjs",
		"test:unit": "tsx --test src/lib/*.test.ts",
		"test:e2e": "playwright test --config=tests-e2e/playwright.config.ts",
		"test:e2e:ui": "playwright test --config=tests-e2e/playwright.config.ts --ui"
	},
	"devDependencies": {
		"@iconify-json/material-symbols": "1.2.69",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/adapter-vercel": "6.3.3",
		"@sveltejs/kit": "2.59.0",
		"@sveltejs/vite-plugin-svelte": "7.0.0",
		"@types/aws-lambda": "8.10.150",
		"@types/node": "^25.6.0",
		"esbuild": "0.27.0",
		"mdsvex": "^0.12.7",
		"normalize.css": "8.0.1",
		"svelte": "5.55.5",
		"svelte-check": "4.4.7",
		"typescript": "6.0.3",
		"unplugin-icons": "23.0.1",
		"vite": "8.0.10"
	},
	"type": "module",
	"dependencies": {
		"@anthropic-ai/sdk": "^0.92.0",
		"@revenuecat/purchases-js": "^1.38.0",
		"@sentry/sveltekit": "^10.0.0",
		"@supabase/ssr": "^0.10.0",
		"@supabase/supabase-js": "^2.105.0",
		"fit-file-parser": "^2.3.3",
		"html-to-image": "^1.11.13",
		"isomorphic-dompurify": "^3.0.0",
		"jszip": "^3.10.1",
		"maplibre-gl": "^5.24.0",
		"marked": "^18.0.3"
	}
}
