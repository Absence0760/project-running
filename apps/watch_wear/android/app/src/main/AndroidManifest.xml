<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required for ConnectivityManager.NetworkCallback (the offline →
         online retry path). Without this, registerNetworkCallback throws
         SecurityException on every launch. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <!-- BODY_SENSORS alone is not enough on Wear OS 3.5+ (API 34+):
         the platform stops delivering HR samples once the display
         goes ambient unless BODY_SENSORS_BACKGROUND is also granted.
         We declare this in the Wear OS Play Data Safety form too. -->
    <uses-permission android:name="android.permission.BODY_SENSORS_BACKGROUND" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- Foreground service for long-running GPS recording. Without this
         the OS kills the recording the moment the watch goes ambient. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- RunRecordingService reads heart rate via Health Services
         (MeasureClient → BODY_SENSORS) while recording, so on targetSdk 35
         it must hold FOREGROUND_SERVICE_HEALTH and enumerate the "health"
         service type below; otherwise Android 14+ throws SecurityException
         when the service starts. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Lets us prompt the user to whitelist this app from battery
         optimisation (Doze / App Standby), which otherwise throttles
         the foreground service after ~10 minutes. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- networkSecurityConfig (res/xml/network_security_config.xml) is
         the canonical mechanism — it scopes cleartext to the dev
         loopback (10.0.2.2) only. The application-level
         usesCleartextTraffic flag was redundant and Play reviewers
         flag it on the manifest scan without reading the NSC,
         so we drop it. -->
    <application
        android:label="Threkir"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:theme="@android:style/Theme.DeviceDefault"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false">

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".recording.RunRecordingService"
            android:exported="false"
            android:foregroundServiceType="location|health" />

        <!-- Active-run glanceable tile. The BIND_TILE_PROVIDER permission
             is enforced by the platform: only the Wear OS Tiles host can
             bind to the service, so `exported=true` is safe (and required
             — the host process is not us). The PREVIEW meta-data points
             at the static drawable shown in the watch face's tile picker;
             the live tile renders dynamically at request time. -->
        <service
            android:name=".tiles.ActiveRunTileService"
            android:exported="true"
            android:label="@string/tile_active_run_label"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_active_run_preview" />
        </service>
    </application>
</manifest>
