<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown in the watch face's tile picker UI (Add tile → list).
         Keep short enough to fit a Wear OS row chip. -->
    <string name="tile_active_run_label">Active run</string>

    <!-- ───────────── Units / formatted values ───────────── -->
    <!-- "%1$s km" — the number is pre-formatted locale-aware by the caller
         (NumberFormat / String.format(Locale.getDefault(), …)) so only the
         unit word is translated here. -->
    <string name="distance_km">%1$s km</string>
    <string name="distance_km_recorded">%1$s km recorded</string>
    <string name="distance_km_to_go">%1$s km to go</string>
    <string name="pace_per_km">%1$s /km</string>
    <!-- Mile variants — selected when the runner's preferred_unit is "mi".
         The number is pre-formatted locale-aware by the caller; only the
         unit word is translated. -->
    <string name="distance_mi">%1$s mi</string>
    <string name="distance_mi_to_go">%1$s mi to go</string>
    <string name="distance_mi_recorded">%1$s mi recorded</string>
    <string name="pace_per_mi">%1$s /mi</string>
    <string name="bpm">%1$d bpm</string>
    <string name="bpm_zone">%1$d bpm · Z%2$d</string>
    <string name="bpm_avg">%1$d bpm avg</string>
    <string name="hr_acquiring">HR…</string>
    <string name="hr_off_wrist">HR off wrist</string>
    <string name="hr_none">No HR</string>
    <string name="kcal">%1$d kcal</string>
    <string name="kcal_est">%1$d kcal (est)</string>
    <plurals name="steps">
        <item quantity="one">%1$d step</item>
        <item quantity="other">%1$d steps</item>
    </plurals>
    <string name="lap_number">Lap %1$d</string>
    <!-- "12:34  ·  5.12 km" — elapsed time + distance in the foreground
         notification. Both halves pre-formatted by the caller. -->
    <string name="notif_time_distance">%1$s  ·  %2$s</string>
    <string name="off_route_distance">Off route · %1$d m</string>

