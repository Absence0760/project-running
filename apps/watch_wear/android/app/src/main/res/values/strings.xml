    <!-- ───────────── TTS spoken phrases ───────────── -->
    <!-- Mirrors apps/mobile_android/lib/l10n/app_*.arb so a runner carrying
         both devices hears the same cues. Numbers in %d positions are spoken
         by the TTS engine; the distance %s in tts_run_complete is formatted
         with a period decimal (locale-independent) so engines don't read a
         comma as "comma". -->
    <string name="tts_run_started">Run started</string>
    <plurals name="tts_split_unit">
        <item quantity="one">%1$d kilometre</item>
        <item quantity="other">%1$d kilometres</item>
    </plurals>
    <string name="tts_pace_tail">Pace %1$d minutes %2$d seconds per kilometre</string>
    <!-- "%1$s. %2$s" — split unit phrase + pace tail (tail may be empty). -->
    <string name="tts_split_phrase">%1$s. %2$s</string>
    <string name="tts_run_complete">Run complete. %1$s kilometres in %2$d minutes.</string>
    <string name="tts_pace_alert_fast">Pick up the pace</string>
    <string name="tts_pace_alert_slow">Slow down</string>
</resources>
