# ─────────────────────────────────────────────────────────────────────────
# Local development defaults — committed on purpose (Wear OS).
#
# Consumed ONLY by the DEBUG build type: app/build.gradle.kts reads this file
# in the `buildTypes { debug { } }` block and emits the values as BuildConfig
# constants that OVERRIDE the safe-for-release `defaultConfig` baseline. The
# `release` build type reads NOTHING from this file — it takes SUPABASE_URL /
# SUPABASE_ANON_KEY (and SENTRY_DSN / MapTiler) from `-P` gradle flags (the
# release workflow injects production values) and keeps every dev flag off. So
# nothing here can leak into a release APK/AAB.
#
# Everything below is local-stack and non-secret: the anon key is the STANDARD
# PUBLIC Supabase local demo key (identical on every `supabase start`,
# published in Supabase's own docs); every URL is loopback. 127.0.0.1 works on
# the Wear OS emulator AND a physical watch via `adb reverse` (which the repo's
# `npm run dev:up` runs for every attached device) — 10.0.2.2 is emulator-only,
# so we deliberately use 127.0.0.1 to cover both.
#
# Need a real MapTiler / Sentry value? Edit this file LOCALLY but DON'T commit
# the change (it's tracked now — `git update-index --skip-worktree` it, or just
# keep the edit out of your commit).
# ─────────────────────────────────────────────────────────────────────────

# Local Supabase stack (API on 54321). Used by SupabaseClient for the direct
# sign-in + BYPASS_LOGIN paths. The paired-phone handoff overrides these at
# runtime with the phone-supplied base_url + anon_key, so they only matter
# when developing a standalone watch without a paired phone.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Auto-sign-in as the seed user (runner@test.com / testtest) on cold start
# when there's no cached session and no phone handoff. Only ever fires against
# the loopback SUPABASE_URL above. Debug-only — release forces this off.
BYPASS_LOGIN=true

# The Wear OS emulator synthesises fake HR samples that look real; set this to
# keep them out of the runs table when developing on the emulator. HR is ON by
# default (real watches record optical HR).
# DISABLE_HR=true

# Map tiles → local Protomaps tileserver (`npm run dev:tiles:up`, port 8080).
# When set, this raster override wins outright and MapTiler is bypassed (no key
# needed). Empty ⇒ MapTiler path (needs PUBLIC_MAPTILER_KEY).
PUBLIC_TILE_URL_TEMPLATE=http://127.0.0.1:8080/styles/basic/{z}/{x}/{y}.png

# MapTiler key unused locally (the Protomaps override above wins). Leave empty.
PUBLIC_MAPTILER_KEY=
