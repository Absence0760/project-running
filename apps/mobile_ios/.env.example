SUPABASE_URL=http://10.0.2.2:54321
SUPABASE_ANON_KEY=
MAPTILER_KEY=
# Optional dev override that points the live-run / run-detail map
# at a different raster-tile URL template (typically a local
# Protomaps tileserver-gl). Set, the override wins outright;
# empty, the app falls back to the MapTiler URL above. Use
# `http://10.0.2.2:8080/...` (not `localhost`) on the Android
# emulator. Boot the local server with `bin/protomaps-dev.sh start`
# from the repo root. See docs/ops/protomaps_local_setup.md +
# decisions.md § 68.
TILE_URL_TEMPLATE=
DEV_USER_EMAIL=
DEV_USER_PASSWORD=
# Base URL the "Share live link" action stitches the run id onto so the
# resulting `/live/{run_id}` URL points at the right spectator host.
# Defaults to the production host when unset.
WEB_BASE_URL=https://app.runapp.com
# OSRM base URL — e.g. https://osrm.threkir.com. When set, the
# in-app route builder issues `/route` + `/nearest` requests against
# this host. Empty → dev falls back to `https://router.project-osrm.org`
# (the community demo). **Release builds throw on first routing call
# when this is empty** — the public demo has no DPA and must not
# receive production GPS waypoints. See
# `apps/job_worker/osrm/` for the self-hosted instance + decisions
# §53 / audit/third-party-data-flows (2026-05-25).
OSRM_URL=
# Go live-hub base URL — e.g. https://live.threkir.com. When set,
# the recorder pushes live spectator pings to
# `${LIVE_HUB_URL}/v1/live/{run_id}/push` (via `LiveHubClient`)
# instead of inserting into Supabase `live_run_pings`. Empty →
# falls back to the legacy Supabase path. See
# `apps/mobile_android/lib/live_hub_client.dart` + the server side
# at `apps/job_worker/internal/livehub/`.
LIVE_HUB_URL=
# BYPASS_PAYWALL is kept out of THIS template, but IS set in the committed
# `.env.local` (the working local-dev config) so the free seed user can
# exercise Pro features. The iOS client reads it only in DEBUG flutter
# builds; release builds ignore the flag, so it can't ship in the IPA.
