<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>de</string>
		<string>fr</string>
		<string>es</string>
		<string>ja</string>
		<string>pt-PT</string>
		<string>pt-BR</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Threkir</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Threkir</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Threkir uses your location to track runs.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Threkir continues tracking runs in the background so you don't lose data if you take a call or lock your phone.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>Threkir reads workout summaries from Apple Health so runs you've recorded on Apple Watch, Nike Run Club, Strava, and other apps can be imported into your history.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>Threkir writes recorded runs back to Apple Health so the rest of your iOS health record stays in sync with what you've logged here.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Threkir connects to your Bluetooth heart-rate strap so it can stream live BPM into your run.</string>
	<key>NSMotionUsageDescription</key>
	<string>Threkir uses motion data to count steps and estimate cadence on treadmill runs without GPS.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Threkir lets you attach photos from your library to your runs.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Threkir saves shared run cards back to your Photos library when you tap "Save to Photos."</string>
	<key>NSCameraUsageDescription</key>
	<string>Threkir uses the camera to scan a food product's barcode so it can look up its nutrition and log it for you.</string>
	<key>NSCalendarsWriteOnlyAccessUsageDescription</key>
	<string>Threkir adds a club event you choose to your calendar. It never reads what else is in there.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>Threkir adds a club event you choose to your calendar. It never reads what else is in there.</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- `audio` is what licenses the AVAudioSession to keep SOUNDING once the
	     app backgrounds. `location` keeps the process alive for GPS but says
	     nothing about audio, so without this entry the spoken cues stop the
	     moment the runner pockets the phone — the case they exist for — while
	     the recording carries on, which makes the failure silent. audio_cues.dart
	     puts the TTS session in the `playback` category, which is the claim this
	     entry backs; scripts/check_ios_native_declarations.mjs derives the
	     requirement from that call rather than from this list. decisions.md § 742. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>location</string>
		<string>processing</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.threkir.backgroundSync</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Supabase auth deep link (signup confirmation / magic link).
	     GoTrue redirects the emailed verify link to this custom scheme;
	     supabase_flutter's app_links listener catches it and completes
	     the PKCE session in-app. Scheme must match
	     ApiClient.kAuthDeepLinkRedirect, the Android manifest
	     intent-filter, AND the Auth -> Redirect URLs allow-list. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.threkir.app.auth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.threkir.app</string>
			</array>
		</dict>
	</array>
	<!-- OS "Open with" for GPX/KML route files (decisions §24 device-led).
	     Neither type is system-declared, so Threkir imports a UTI for each
	     and registers as a Viewer; receive_sharing_intent delivers the
	     opened document to lib/shared_file_import.dart, which imports it as
	     a route. This covers document "Open with" — the iOS *system share
	     sheet* additionally needs a Share Extension target (deferred). -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>GPS Exchange Format</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.topografix.gpx</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Keyhole Markup Language</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.google.earth.kml</string>
			</array>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.topografix.gpx</string>
			<key>UTTypeDescription</key>
			<string>GPS Exchange Format</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>gpx</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/gpx+xml</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.google.earth.kml</string>
			<key>UTTypeDescription</key>
			<string>Keyhole Markup Language</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.xml</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>kml</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.google-earth.kml+xml</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
