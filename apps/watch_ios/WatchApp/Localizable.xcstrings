        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Recuperar" } }
      }
    },
    "Recover unsaved run from %@, %@, %@?" : {
      "comment" : "Recovery prompt. Placeholders: date, distance, duration — each pre-formatted locale-aware by the caller.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Nicht gespeicherten Lauf von %1$@, %2$@, %3$@ wiederherstellen?" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "¿Recuperar la carrera sin guardar del %1$@, %2$@, %3$@?" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Récupérer la course non enregistrée du %1$@, %2$@, %3$@ ?" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "%1$@、%2$@、%3$@ の未保存のランを復元しますか？" } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Recuperar a corrida não salva de %1$@, %2$@, %3$@?" } }
      }
    },
    "Restores the unsaved run from the last checkpoint" : {
      "comment" : "VoiceOver hint on the Recover button.",
      "localizations" : {
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Stellt den nicht gespeicherten Lauf vom letzten Prüfpunkt wieder her" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Restaura la carrera sin guardar desde el último punto de control" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Restaure la course non enregistrée depuis le dernier point de contrôle" } },
