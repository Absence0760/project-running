        "de" : { "stringUnit" : { "state" : "translated", "value" : "Keine — zum Einstellen tippen" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Ninguno — toca para ajustar" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucune — touchez pour définir" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "なし — タップして設定" } },
