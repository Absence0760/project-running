# ─────────────────────────────────────────────────────────────────────────
# Local development defaults — committed on purpose.
#
# Loaded ONLY by DEBUG builds: main.dart gates `dotenv.load('.env.development')`
# on kDebugMode, and release builds read --dart-define instead — so nothing
# here ships in a release APK (audit High / decisions §13). Everything is
# local-stack and non-secret (the anon key is the standard public Supabase
# local demo key; every URL is loopback).
#
# Repo-wide convention (decisions §137): this committed file is the ready-to-run
# default. On mobile the per-machine override is `--dart-define` (which wins via
# mergeWith), NOT a `.env.local` file — flutter_dotenv loads from the bundled
# asset, so a gitignored `.env.local` wouldn't be on the asset path. Need a real
# MapTiler/Strava key locally? Pass `--dart-define`, or edit this file but DON'T
# commit the change.
#
# Physical device OR emulator: keep 127.0.0.1 and run `adb reverse` (which
# `npm run dev:core` does for every attached device). 127.0.0.1 + adb reverse
# works for BOTH; 10.0.2.2 is emulator-only.
# ─────────────────────────────────────────────────────────────────────────

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Map tiles → local Protomaps tileserver (`npm run dev:tiles:up`). When set,
# this raster override wins outright; empty → falls back to MapTiler.
TILE_URL_TEMPLATE=http://127.0.0.1:8080/styles/basic/{z}/{x}/{y}.png

# AI Coach + "Share live link" host → the local web dev server
# (`npm run dev:run:web`, port 7777).
WEB_BASE_URL=http://127.0.0.1:7777

# Auto-login as the seed user on launch (fires only against a loopback
# SUPABASE_URL — never production; see dev_auto_login.dart).
DEV_USER_EMAIL=runner@test.com
DEV_USER_PASSWORD=testtest

# Unlock Pro-gated features for the free seed user during local dev. Read
# only in DEBUG builds; release builds ignore it.
BYPASS_PAYWALL=true
