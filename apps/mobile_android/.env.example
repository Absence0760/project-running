SUPABASE_URL=http://10.0.2.2:54321
SUPABASE_ANON_KEY=
MAPTILER_KEY=
DEV_USER_EMAIL=
DEV_USER_PASSWORD=
# Base URL the "Share live link" action stitches the run id onto so the
# resulting `/live/{run_id}` URL points at the right spectator host.
# Defaults to the production host when unset.
WEB_BASE_URL=https://app.runapp.com
# Go live-hub base URL — e.g. https://live.threkir.com. When set,
# the recorder pushes live spectator pings to
# `${LIVE_HUB_URL}/v1/live/{run_id}/push` (via `LiveHubClient`)
# instead of inserting into Supabase `live_run_pings`. Empty →
# falls back to the legacy Supabase path. See
# `apps/mobile_android/lib/live_hub_client.dart` + the server side
# at `apps/job_worker/internal/livehub/`.
LIVE_HUB_URL=
# BYPASS_PAYWALL is intentionally NOT exported here. If you need to
# bypass the paywall for a local debug build, set it ad-hoc in your
# own .env.local — never commit it. The Android client reads this
# only in DEBUG flutter builds; release builds ignore the flag.
