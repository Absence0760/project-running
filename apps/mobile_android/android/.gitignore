# Flutter's android template gitignores the wrapper (gradle-wrapper.jar,
# gradlew, gradlew.bat) on the assumption that only `flutter build` ever drives
# Gradle here. CI also runs this project's own unit tests, which needs an
# executable that is in the checkout — so the wrapper is committed, matching
# apps/watch_wear/android (decisions § 1439).
/.gradle
/captures/
/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks

# Kotlin compile-session debris from a local `./gradlew` run in this project.
.kotlin/
