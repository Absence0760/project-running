<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Note: FOREGROUND_SERVICE_DATA_SYNC was added briefly during
         the May 2026 audit pass but is unused. Workmanager (our
         background-sync) on Android schedules via JobScheduler /
         SystemJobService, not as a foreground service; no worker
         in this app calls setForeground(). The only foreground
         service we DO promote is geolocator's
         GeolocatorLocationService, which carries
         foregroundServiceType="location" baked in by the plugin
         and is covered by FOREGROUND_SERVICE_LOCATION above. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- image_picker (run photos) on Android 13+ (API 33+) reads the
         user's photos through the photo picker; READ_MEDIA_IMAGES is
         required for the legacy gallery path the picker falls back to
         on devices without the photo-picker module. Without it the
         Play Data Safety form's "Photos and videos - read" entry
         doesn't line up with what the binary actually requests at
         runtime and Play flags the mismatch. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <!-- Health Connect read permissions for importing workouts.
         Mirrored in res/xml/health_permissions.xml so the Play
         Console Health-Connect data-access form sees the same set. -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />

    <!-- Bluetooth LE for chest-strap HR monitors. Android 12+ (API 31)
         replaced legacy BLUETOOTH / BLUETOOTH_ADMIN / ACCESS_FINE_LOCATION
         for scan with the split BLUETOOTH_SCAN / BLUETOOTH_CONNECT pair.
         `neverForLocation` lets us scan without triggering the location
         permission prompt — we already have location for GPS. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
                     android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <application
        android:label="Threkir"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Health Connect permission set declared in res/xml/. Play
                 Console reads this to validate the Health Connect data-
                 access form against the binary's actual permission list. -->
            <meta-data
              android:name="health_permissions"
              android:resource="@xml/health_permissions" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Health Connect privacy-policy rationale entry-point.
                 Android invokes this intent when the user taps "Privacy
                 policy" inside the Health Connect permission sheet.
                 Without it the sheet falls back to a generic message
                 and Play Console flags it as a Health Connect policy
                 gap. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- flutter_web_auth_2 callback activity. Captures the Strava
             OAuth redirect (threkir://strava-callback?code=...) and
             hands it back to the in-flight authenticate() call. The
             scheme must match `kStravaCallbackScheme` in lib/strava.dart
             AND be allow-listed in the Strava developer console + the
             `STRAVA_ALLOWED_REDIRECTS` env var on the Edge Function. -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true">
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="threkir" />
            </intent-filter>
        </activity>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required so the Health Connect plugin can detect the Health Connect app -->
        <package android:name="com.google.android.apps.healthdata"/>
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
        </intent>
    </queries>
</manifest>
