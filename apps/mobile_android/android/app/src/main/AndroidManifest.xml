<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- ACCESS_BACKGROUND_LOCATION: needed to keep recording a run's GPS
         trace when the screen locks / the app is backgrounded. Requested
         at runtime with an in-app rationale, NOT at first launch — see
         `lib/background_location_nudge.dart` (shouldNudgeBackgroundLocation
         + run_screen._maybeNudgeBackgroundLocation), which deep-links to
         app settings only after foreground location is granted. The Play
         Console "prominent disclosure" form must reference this flow.
         (audit-findings 2026-05-30 Medium — Play human-review aid.) -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- Note: FOREGROUND_SERVICE_DATA_SYNC was added briefly during
         the May 2026 audit pass but is unused. Workmanager (our
         background-sync) on Android schedules via JobScheduler /
         SystemJobService, not as a foreground service; no worker
         in this app calls setForeground(). The only foreground
         service we DO promote is geolocator's
         GeolocatorLocationService, which carries
         foregroundServiceType="location" baked in by the plugin
         and is covered by FOREGROUND_SERVICE_LOCATION above. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Camera: barcode scan for the nutrition log fast-path (mobile_scanner).
         Declared optional (android:required="false") so the app still installs
         on a camera-less device — the scan affordance degrades to the
         search / manual-entry fallback. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- Health Connect read permissions for importing workouts.
         Mirrored in res/xml/health_permissions.xml so the Play
         Console Health-Connect data-access form sees the same set. -->
    <uses-permission android:name="android.permission.health.READ_EXERCISE" />
    <uses-permission android:name="android.permission.health.READ_DISTANCE" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <!-- Write recorded runs back to Health Connect (persona #36). Opt-in
         per-device; the workout session + its distance record need these. -->
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" />
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" />
    <!-- BLE chest-strap HR captured during a run flows back to Health
         Connect alongside the workout (persona round-5). -->
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" />

    <!-- Bluetooth LE for chest-strap HR monitors. Android 12+ (API 31)
         replaced legacy BLUETOOTH / BLUETOOTH_ADMIN / ACCESS_FINE_LOCATION
         for scan with the split BLUETOOTH_SCAN / BLUETOOTH_CONNECT pair.
         `neverForLocation` lets us scan without triggering the location
         permission prompt — we already have location for GPS. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
                     android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- ── Transitive plugin permissions made explicit ────────────────
         The permissions below are injected into the merged manifest by
         plugin AARs, not requested directly by app code. Surfacing them
         in this source-controlled manifest (suppressed or annotated)
         keeps the permission set the operator sees here in lockstep
         with the binary — otherwise they are invisible until the APK is
         built and the Play Data Safety form silently drifts.
         audit/app-store-privacy (2026-05-30) Critical. -->

    <!-- androidx.biometric (pulled transitively) ships USE_BIOMETRIC +
         USE_FINGERPRINT. This app has no biometric / fingerprint auth
         surface — secure storage uses the Android Keystore without a
         biometric prompt — so strip them rather than disclose an unused
         capability. tools:node="remove" deletes them at merge time. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC"
                     tools:node="remove" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT"
                     tools:node="remove" />

    <!-- workmanager (androidx.work) injects RECEIVE_BOOT_COMPLETED so
         its boot receiver can re-schedule the hourly background-sync
         task after a device reboot. registerBackgroundSync() in
         main.dart also re-registers the task on every app launch, so
         this only buys boot-time resume without the user reopening the
         app. Kept because that resume is genuine product behaviour;
         declared here so it is visible to the Play Data Safety form,
         which must disclose it (App activity → background sync at
         boot). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="Threkir"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Health Connect permission set declared in res/xml/. Play
                 Console reads this to validate the Health Connect data-
                 access form against the binary's actual permission list. -->
            <meta-data
              android:name="health_permissions"
              android:resource="@xml/health_permissions" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Supabase auth deep link (signup confirmation / magic link).
                 GoTrue redirects the emailed verify link here after
                 verifying; supabase_flutter's app_links listener catches
                 the incoming URI and completes the PKCE session in-app.
                 Scheme is deliberately distinct from the flutter_web_auth_2
                 `threkir://` OAuth scheme above. Must match
                 `ApiClient.kAuthDeepLinkRedirect`, the iOS Info.plist
                 CFBundleURLTypes entry, AND the Auth -> URL Configuration
                 -> Redirect URLs allow-list. -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.threkir.app" android:host="login-callback" />
            </intent-filter>
            <!-- Health Connect privacy-policy rationale entry-point.
                 Android invokes this intent when the user taps "Privacy
                 policy" inside the Health Connect permission sheet.
                 Without it the sheet falls back to a generic message
                 and Play Console flags it as a Health Connect policy
                 gap. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- flutter_web_auth_2 callback activity. Captures the Strava
             OAuth redirect (threkir://strava-callback?code=...) and
             hands it back to the in-flight authenticate() call. The
             scheme must match `kStravaCallbackScheme` in lib/strava.dart
             AND be allow-listed in the Strava developer console + the
             `STRAVA_ALLOWED_REDIRECTS` env var on the Edge Function. -->
        <activity
            android:name="com.linusu.flutter_web_auth_2.CallbackActivity"
            android:exported="true">
            <intent-filter android:label="flutter_web_auth_2">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="threkir" />
            </intent-filter>
        </activity>

        <!-- Explicit override of geolocator's GeolocatorLocationService
             so the foregroundServiceType="location" attribute appears in
             OUR manifest, not just the plugin's merged manifest. Android
             14+ (API 34) raises SecurityException if a foreground service
             starts without a declared type that matches the runtime
             permission; if a future geolocator version dropped the type
             from its manifest, manifest-merge would silently produce a
             type-less service. Plus the Play Console Data Safety reviewer
             reads the AS-COMPILED manifest and the type must appear here
             to satisfy the Background Location justification cross-check.
             /audit/app-store-privacy May 2026 High closeout.
             tools:node="merge" so the plugin's attributes (export,
             stopWithTask, etc.) stay intact. -->
        <service
            android:name="com.baseflow.geolocator.GeolocatorLocationService"
            android:foregroundServiceType="location"
            tools:node="merge" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Required so the Health Connect plugin can detect the Health Connect app -->
        <package android:name="com.google.android.apps.healthdata"/>
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
        </intent>
    </queries>
</manifest>
