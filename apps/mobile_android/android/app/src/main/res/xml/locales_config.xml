<?xml version="1.0" encoding="utf-8"?>
<!-- Per-app language support (Android 13+). Lists every locale the app ships
     an ARB catalogue for; the platform offers these in system Settings → Apps
     → Threkir → Language, which is a path to a catalogue the in-app picker is
     not the only owner of. Held to lib/l10n by the locale-reach guard in
     test/architecture_guards_test.dart (decisions § 740). `pt` is European
     Portuguese, `pt-BR` Brazilian. -->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="de" />
    <locale android:name="fr" />
    <locale android:name="es" />
    <locale android:name="ja" />
    <locale android:name="pt" />
    <locale android:name="pt-BR" />
</locale-config>
