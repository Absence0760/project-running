# ─────────────────────────────────────────────────────────────────────────
# Local development defaults — committed on purpose.
#
# Point `supabase functions serve` at this file for a ready-to-run local
# stack:  supabase functions serve --env-file .env.development
#
# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the CLI for local `functions serve` — don't set them here.
# Everything below is non-secret: third-party credentials are left empty (the
# functions fail closed without them, which is the correct local default) and
# the one real value is the loopback redirect the web dev server uses.
#
# Need a real key (Strava, RevenueCat, Sentry)? Copy this to a gitignored
# `.env.local`, fill it in, and serve `--env-file .env.local`. That file wins;
# never commit it. Keep this file and `.env.example` in sync on new vars.
# ─────────────────────────────────────────────────────────────────────────

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=
STRAVA_WEBHOOK_SECRET=
PARKRUN_USER_AGENT=RunApp/1.0 (contact@runapp.com)
# Left unset in local dev so the RunSignUp leg stays fail-closed (503); the
# parkrun + manual-paste race paths work without it.
RUNSIGNUP_API_KEY=
RUNSIGNUP_API_SECRET=
RACE_IMPORT_USER_AGENT=RunApp/1.0 (contact@runapp.com)
REVENUECAT_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
# Stripe Connect — paid events (club_events.md slice P1). TEST MODE ONLY.
# Left empty here: the events EFs fail closed (503 stripe_not_configured /
# webhook_not_configured) without real keys, which is the correct local
# default. Put real sk_test_ / ca_ / whsec_ keys in a gitignored
# .env.local and serve --env-file .env.local. The whsec_ value is the one
# `stripe listen --forward-to .../stripe-events-webhook` prints — a
# SEPARATE endpoint + secret from the RevenueCat forwarder. See
# docs/testing/local_testing_stubs.md.
STRIPE_SECRET_KEY=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_EVENTS_WEBHOOK_SECRET=
# Origins allowed for Account Link return/refresh + Checkout success/cancel.
# The events EFs 503 when empty; the local web dev server runs on 7777.
STRIPE_EVENTS_ALLOWED_REDIRECTS=http://localhost:7777
# Loopback redirect the local web dev server (port 7777) uses for the
# Strava connect flow. strava-import returns 503 when this is empty.
STRAVA_ALLOWED_REDIRECTS=http://localhost:7777/settings/integrations
SENTRY_DSN=
APP_RELEASE=
REVENUECAT_SECRET_API_KEY=
FCM_SERVER_KEY=
DELETION_AUDIT_KEY=
VAPID_PRIVATE_KEY=
