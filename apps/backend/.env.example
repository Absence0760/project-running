STRAVA_CLIENT_ID=12345
STRAVA_CLIENT_SECRET=abc...
# Verify-token returned in the GET handshake when Strava creates the
# webhook subscription (sent by us in POST /push_subscriptions and
# echoed back to us via hub.verify_token).
STRAVA_VERIFY_TOKEN=long_random_string_we_chose
# Shared secret embedded in the webhook callback URL configured in
# Strava (e.g. https://<host>/strava-webhook?secret=<this>). Strava
# preserves the URL's query string on both GET and POST, so the same
# value guards both methods. Required: the function fails closed
# without it. Generate with `openssl rand -hex 32`.
STRAVA_WEBHOOK_SECRET=
PARKRUN_USER_AGENT=RunApp/1.0 (contact@runapp.com)
# RevenueCat webhook HMAC verification secret.
# Set this on the RevenueCat dashboard at Integrations → Webhooks → Signing Secret.
REVENUECAT_WEBHOOK_SECRET=whsec_...
# Shared secret the pg_cron job passes to the refresh-tokens Edge
# Function in `Authorization: Bearer ${CRON_SECRET}`. Required —
# without it refresh-tokens is publicly invokable and an attacker can
# spin every Strava integration's refresh-token loop on demand.
# Generate with `openssl rand -hex 32`. Set the same value on the EF
# secret store and on the cron schedule's request headers.
CRON_SECRET=
# Comma-separated allow-list of redirect URIs strava-import:connect
# will accept. The web client sends `redirect_uri` along with the
# auth code; the EF rejects mismatches. Strava's /authorize already
# pins callbacks to the registered domain, but only at path-prefix
# granularity — this allow-list pins the exact URI shape so a code
# captured against an unrelated path under our domain can't be
# token-exchanged through this function. Empty value disables the
# check (dev / single-tenant). Production should set both prod and
# any preview deploy URIs.
STRAVA_ALLOWED_REDIRECTS=
