# Committed local-dev env for the AUTO-STARTED edge runtime. The CLI
# loads this file on `supabase start` (it is the only env that runtime
# gets), so the auth-email send-email hook works out of the box — GoTrue
# signs with the committed [auth.hook.send_email].secrets value in
# ../config.toml and the function verifies the same value from here.
# Non-secret local-stack values ONLY; real keys go in ../../.env.local
# (gitignored), served via `supabase functions serve --env-file`.
# Keep SEND_EMAIL_HOOK_SECRET in lockstep with config.toml.
SEND_EMAIL_HOOK_SECRET=v1,whsec_bG9jYWwtZGV2LW9ubHktc2VuZC1lbWFpbC1ob29rLXNlY3JldA==
# Mailpit's SMTP listener as seen from inside the runtime container
# (host.docker.internal = the host, port pinned in ../config.toml).
SMTP_HOST=host.docker.internal
SMTP_PORT=54325
SMTP_FROM="Threkir <noreply@threkir.com>"
